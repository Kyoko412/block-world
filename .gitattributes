# 统一文本换行，避免 Windows/Linux 互相污染
* text=auto eol=lf

# 二进制：不要让 git 做换行转换，也不要尝试 diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.wav  binary
*.ogg  binary
*.mp3  binary
*.zip  binary
*.ico  binary
*.ttf  binary
*.sqlite binary

# 文档/配置显式声明为文本
*.md   text eol=lf
*.json text eol=lf
*.lua  text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.sh   text eol=lf
